# 复制为 .env 后填写；不要提交真实密钥。

# 必填：至少 32 个字符的随机应用密钥，所有服务实例保持一致。
# 生成：bun -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NUXT_APP_SECRET=

# GitHub OAuth App：https://github.com/settings/developers
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
# 与 OAuth App 的 Authorization callback URL 保持一致；生产环境替换为实际域名。
NUXT_OAUTH_GITHUB_REDIRECT_URL=http://localhost:3000/api/auth/github

# 允许登录的 GitHub 用户名，以英文逗号分隔；留空拒绝所有账号。
NUXT_GITHUB_ALLOWED_USERS=

# 可选：站点对外源地址，不含路径；留空按请求源地址解析，生产环境使用 HTTPS。
NUXT_PUBLIC_SITE_URL=

# 可选：独立的 MCP/OAuth 签名密钥，至少 16 个字符；留空从 NUXT_APP_SECRET 派生。
# 轮换会使已签发的 MCP 令牌和 OAuth 签名数据失效。
NUXT_MCP_TOKEN_SECRET=
